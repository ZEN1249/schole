#include <iostream>
#include <cstdlib>
#include <ctime>
#include <vector>
#include <algorithm>
#include <string>

using namespace std;

struct Bonus {
    string name;
    string type;
    int value;
    int acqChance;
    int effChance;
};

int main() {
    srand(static_cast<unsigned int>(time(0)));
    int health = 100;
    
    vector<string> locations = {"Wioska", "Pustynia", "Las", "Jaskinia", "Zamek"};
    random_shuffle(locations.begin(), locations.end());
    
    vector<string> altDesc = {
        "Przed toba stoi tajemnicza droga.",
        "Zauwazasz dziwne znaki na ziemi.",
        "Slyszysz odglosy z pobliskiego lasu.",
        "Czujesz, ze cos tu jest nie tak."
    };
    
    for (int stage = 0; stage < 5; stage++) {
        cout << "========================================" << endl;
        cout << "Etap " << stage + 1 << endl;
        string currentLocation = locations[stage];
        cout << "Lokalizacja: " << currentLocation << endl;
        
        int stageDamage = 0;
        if (currentLocation == "Wioska") {
            stageDamage = rand() % 5 + 1;
        } else if (currentLocation == "Pustynia") {
            stageDamage = rand() % 6 + 5;
        } else if (currentLocation == "Las") {
            stageDamage = rand() % 6 + 10;
        } else if (currentLocation == "Jaskinia") {
            stageDamage = rand() % 6 + 15;
        } else if (currentLocation == "Zamek") {
            stageDamage = rand() % 11 + 20;
        }
        health -= stageDamage;
        cout << "W tej lokalizacji tracisz " << stageDamage << " punktow zdrowia." << endl;
        cout << "Aktualne zdrowie: " << health << endl << endl;
        
        vector<string> options = altDesc;
        random_shuffle(options.begin(), options.end());
        string option1 = options[0];
        string option2 = options[1];
        cout << "Wybierz jedna z dwoch opcji:" << endl;
        cout << "1. " << option1 << endl;
        cout << "2. " << option2 << endl;
        cout << "Twoj wybor (1 lub 2): ";
        int choice;
        cin >> choice;
        if(choice != 1 && choice != 2) {
            choice = 1;
        }
        int altEffect = (rand() % 41) - 20;
        health += altEffect;
        if (altEffect >= 0)
            cout << "Twoja decyzja przyniosla +" << altEffect << " punktow zdrowia." << endl;
        else
            cout << "Twoja decyzja przyniosla " << altEffect << " punktow zdrowia." << endl;
        
        cout << endl;
        
        vector<string> healNames = {"Medyczny Eliksir", "Ziolowy Napar", "Regenerujaca Kropla", "Eliksir Zycia", "Boski Eliksir", "Leczniczy Nektar"};
        vector<string> damageNames = {"Trujaca Mikstura", "Cierniowy Amulet", "Morderczy Eliksir", "Zatrute Zloto", "Niszczycielska Mikstura", "Zatruty Kwiat"};
        
        vector<Bonus> bonusPool;
        for (int i = 0; i < healNames.size(); i++) {
            Bonus b;
            b.name = healNames[i];
            b.type = "heal";
            b.value = (rand() % 21) + 10;
            b.acqChance = (rand() % 71) + 30;
            b.effChance = (rand() % 71) + 30;
            bonusPool.push_back(b);
        }
        for (int i = 0; i < damageNames.size(); i++) {
            Bonus b;
            b.name = damageNames[i];
            b.type = "damage";
            b.value = (rand() % 16) + 5;
            b.acqChance = (rand() % 71) + 30;
            b.effChance = (rand() % 71) + 30;
            bonusPool.push_back(b);
        }
        
        random_shuffle(bonusPool.begin(), bonusPool.end());
        vector<Bonus> availableBonuses;
        availableBonuses.push_back(bonusPool[0]);
        availableBonuses.push_back(bonusPool[1]);
        
        cout << "Dostepne bonusy:" << endl;
        for (int i = 0; i < availableBonuses.size(); i++) {
            cout << i + 1 << ". " << availableBonuses[i].name << " - ";
            if (availableBonuses[i].type == "heal")
                cout << "Bonus zdrowia: +" << availableBonuses[i].value;
            else
                cout << "Bonus zdrowia: -" << availableBonuses[i].value;
            cout << " (szansa na otrzymanie: " << availableBonuses[i].acqChance 
                 << "%, szansa dzialania: " << availableBonuses[i].effChance << "%)" << endl;
        }
        cout << endl;
        
        int bonusChoice;
        cout << "Wybierz bonus (1 lub 2): ";
        cin >> bonusChoice;
        if(bonusChoice != 1 && bonusChoice != 2) {
            bonusChoice = 1;
        }
        
        Bonus chosenBonus = availableBonuses[bonusChoice - 1];
        cout << "Przetwarzanie bonusu: " << chosenBonus.name << " - ";
        int roll = rand() % 100;
        if (roll < chosenBonus.acqChance) {
            cout << "Otrzymano bonus. ";
            int roll2 = rand() % 100;
            if (roll2 < chosenBonus.effChance) {
                if (chosenBonus.type == "heal") {
                    health += chosenBonus.value;
                    cout << "Dzialal bonus, dodano " << chosenBonus.value << " punktow zdrowia.";
                } else {
                    health -= chosenBonus.value;
                    cout << "Dzialal bonus, odjeto " << chosenBonus.value << " punktow zdrowia.";
                }
            } else {
                cout << "Bonus nie zadzialal.";
            }
        } else {
            cout << "Nie otrzymano bonusu.";
        }
        cout << endl;
        
        cout << "Aktualne zdrowie po zastosowaniu bonusu: " << health << endl;
        cout << endl << "Koniec etapu " << stage + 1 << ". Aktualne zdrowie: " << health << endl;
        cout << "========================================" << endl << endl;
    }
    
    cout << "Przygoda zakonczona. Twoje zdrowie koncowe: " << health << endl;
    return 0;
}
