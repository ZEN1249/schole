📌 10. Galeria (next / prev)

<img id="img" src="1.jpg" width="200">
<button onclick="next()">></button>

<script>
let nr = 1;

function next() {
  nr++;
  if (nr > 3) nr = 1;

  document.getElementById("img").src = nr + ".jpg";
}
</script>


