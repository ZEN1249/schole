📌 7. Popup własny (lepszy na punkty)

<button onclick="pokaz()">Pokaż popup</button>

<div id="popup" style="display:none; border:1px solid black;">
  To jest popup
  <button onclick="zamknij()">X</button>
</div>

<script>
function pokaz() {
  document.getElementById("popup").style.display = "block";
}

function zamknij() {
  document.getElementById("popup").style.display = "none";
}
</script>


