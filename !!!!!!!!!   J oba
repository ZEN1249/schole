📌 8. Liczenie (np. checkboxy – bardzo częste)

<input type="checkbox" id="a" value="10"> A<br>
<input type="checkbox" id="b" value="20"> B<br>

<button onclick="licz()">Oblicz</button>

<p id="wynik"></p>

<script>
function licz() {
  let suma = 0;

  if (document.getElementById("a").checked) {
    suma += 10;
  }

  if (document.getElementById("b").checked) {
    suma += 20;
  }

  document.getElementById("wynik").innerHTML = suma;
}
</script>


⸻

📌 9. Sprawdzanie hasła (częsty motyw)

<input type="password" id="p1">
<input type="password" id="p2">
<button onclick="sprawdz()">Sprawdź</button>

<script>
function sprawdz() {
  let p1 = document.getElementById("p1").value;
  let p2 = document.getElementById("p2").value;

  if (p1 === p2) {
    alert("Hasła są takie same");
  } else {
    alert("Hasła różne");
  }
}
</script>


