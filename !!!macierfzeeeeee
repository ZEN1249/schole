using System;

class Program
{
    static void Main()
    {
        Console.WriteLine("PODAJ WYMIARY MACIERZY");

        Console.Write("Liczba wierszy: ");
        int W = Convert.ToInt32(Console.ReadLine());

        Console.Write("Liczba kolumn: ");
        int K = Convert.ToInt32(Console.ReadLine());

        int[,] A = new int[W, K];
        int[,] B = new int[W, K];
        int[,] C = new int[W, K];

        Console.WriteLine("\n=== WARTOSCI DLA MACIERZY A ===");

        for (int i = 0; i < A.GetLength(0); i++)
        {
            for (int j = 0; j < A.GetLength(1); j++)
            {
                Console.Write($"A[{i},{j}] = ");
                A[i, j] = Convert.ToInt32(Console.ReadLine());
            }
        }

        Console.WriteLine("\n=== WARTOSCI DLA MACIERZY B ===");

        for (int i = 0; i < B.GetLength(0); i++)
        {
            for (int j = 0; j < B.GetLength(1); j++)
            {
                Console.Write($"B[{i},{j}] = ");
                B[i, j] = Convert.ToInt32(Console.ReadLine());
            }
        }

        // dodawanie

        for (int i = 0; i < W; i++)
        {
            for (int j = 0; j < K; j++)
            {
                C[i, j] = A[i, j] + B[i, j];
            }
        }

        Console.WriteLine("\n=== WYNIK DODAWANIA ===");

        for (int i = 0; i < C.GetLength(0); i++)
        {
            Console.Write("|");

            for (int j = 0; j < C.GetLength(1); j++)
            {
                Console.Write(C[i, j] + "|");
            }

            Console.WriteLine();
        }
    }
}
